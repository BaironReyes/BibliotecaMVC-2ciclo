@model ErrorViewModel

@{
    ViewData["Title"] = "Algo salió mal";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-warning text-center">
            <div class="card-body p-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning-subtle mb-4"
                     style="width: 110px; height: 110px;">
                    <span class="fs-1" aria-hidden="true"></span>
                </div>

                <h1 class="h2 mb-3">¡Ups! Algo salió mal</h1>
                <p class="text-muted mb-4">
                    Ocurrió un problema inesperado mientras procesábamos tu solicitud.
                    El incidente quedó registrado. Puedes intentarlo de nuevo o seguir navegando por BibliotecaMVC.
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
                    <a asp-controller="Libros" asp-action="Index" class="btn btn-outline-secondary">Ver libros</a>
                    <a asp-controller="Categorias" asp-action="Index" class="btn btn-outline-secondary">Ver categorías</a>
                </div>

                @if (!string.IsNullOrEmpty(Model?.RequestId))
                {
                    <p class="small text-muted mt-4 mb-0">Código de referencia: <code>@Model.RequestId</code></p>
                }
            </div>
        </div>
    </div>
</div>