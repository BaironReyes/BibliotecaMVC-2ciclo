@model IEnumerable<BibliotecaMVC.Models.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Listado de Categorias</h2>
</div>
<a class="btn btn-primary" asp-controller="Categorias" asp-action="Create">Agregar Categoria</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var categoria in Model)
        {
            <tr>
                <td>@categoria.ID</td>
                <td>@categoria.Nombre</td>
                <td>@categoria.Descripcion</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@categoria.ID" class="btn btn-sm btn-warning">Editar</a>

                    <form asp-action="Delete" asp-route-id="@categoria.ID" method="post" class="d-inline form-eliminar-categoria">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>

</table>

@section Scripts
{
    <script>
        var mensaje = '@(TempData["SuccessMessage"] ?? "")';
        if (mensaje) {
            Swal.fire({
                icon: 'success',
                title: 'Exito',
                text: mensaje,
                timer: 2000,
                showConfirmButton: false
            });
        }

        
        document.querySelectorAll('.form-eliminar-categoria').forEach(function(form) {
            form.addEventListener('submit', function(e) {
                e.preventDefault();

                Swal.fire({
                    icon: 'warning',
                    title: '¿Eliminar categoría?',
                    text: 'Esta acción no se puede deshacer.',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#d33'
                }).then(function(result) {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}