@{
    ViewData["Title"] = "Acceso denegado";
    var nombre = User.Identity?.Name ?? "visitante";
    var rol = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Bibliotecario") ? "Bibliotecario" : "Usuario";
}

<style>
    .acceso-denegado .comparacion {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1.25rem 1rem;
    }

    .acceso-denegado .etiqueta {
        text-align: right;
        font-weight: 700;
        font-size: clamp(1.1rem, 4vw, 2rem);
        overflow-wrap: anywhere;
    }

    .acceso-denegado .flecha {
        font-size: clamp(1.8rem, 7vw, 3.2rem);
    }

    .acceso-denegado .medio {
        width: 100%;
        max-width: 280px;
        height: auto;
    }

    .acceso-denegado .foto-gato {
        width: min(320px, 80vw);
    }

    .acceso-denegado .apuntar {
        display: inline-block;
        animation: apuntar 0.9s ease-in-out infinite;
    }

    @@keyframes apuntar {
        0%, 100% {
            transform: translateX(0);
        }

        50% {
            transform: translateX(10px);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .acceso-denegado .apuntar {
            animation: none;
        }
    }
</style>

<div class="acceso-denegado row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-danger text-center">
            <div class="card-body p-4 p-md-5">

                <h1 class="display-6 text-danger fw-bold mb-2">¿Para dónde ibas, @nombre?</h1>
                <p class="fs-5 mb-4">Necesitas ser admin para esta acción.</p>

                <div class="comparacion mb-2">
                    <div class="etiqueta text-success">Admin</div>
                    <div class="apuntar flecha" aria-hidden="true">➡️</div>
                    <video class="medio rounded-4 shadow" autoplay muted loop playsinline controls>
                        <source src="~/videos/admin.mp4" type="video/mp4" />
                        Tu navegador no soporta la reproducción de video.
                    </video>

                    <div class="etiqueta text-danger">@nombre</div>
                    <div class="apuntar flecha" aria-hidden="true">➡️</div>
                    <img src="~/images/burro.png"
                         alt="Burro mirando fijamente a la cámara"
                         class="medio rounded-4 shadow" />
                </div>

                <hr class="my-4" />

                <figure class="m-0 mb-4">
                    <img src="~/images/gato.png"
                         alt="Gato maullando de forma exagerada mientras señala con el dedo"
                         class="img-fluid rounded-4 shadow foto-gato" />
                    <figcaption class="small text-muted mt-2">El guardia de seguridad al verte intentar entrar</figcaption>
                </figure>

                <p class="small text-muted mb-4">
                    Tu rol actual (<span class="badge bg-secondary">@rol</span>) no tiene permisos para realizar esta acción.
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
                    <a asp-controller="Libros" asp-action="Index" class="btn btn-outline-secondary">Ir a Libros</a>
                </div>
            </div>
        </div>
    </div>
</div>